  <groupId>dev.warden</groupId>
  <artifactId>[[ .Repo ]]</artifactId>
  <version>0.1.0</version>
  <name>[[ .Repo ]]</name>
  <description>Warden service [[ .Name ]] (owner: [[ .Owner ]])</description>

  <properties>
    <java.version>25</java.version>
    <jib-maven-plugin.version>3.5.2</jib-maven-plugin.version>
    <!-- Pinned by digest (hub versions.yaml runtime.base-image). -->
    <warden.base-image>eclipse-temurin:25-jre-noble@sha256:3f2223fe04b750aa5a8179e29b5c9a1ddf7665fc9bb08bfe11ad01d143bc13a5</warden.base-image>
    <warden.image>[[ .Image ]]</warden.image>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>build-info</goal>
            </goals>
          </execution>
        </executions>
